# ShopSphere AI - Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or API keys to version control.

# Application Configuration
NEXT_PUBLIC_APP_NAME="ShopSphere AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# External API Configuration
NEXT_PUBLIC_API_BASE_URL="https://dummyjson.com"

# Data Provider Configuration ('dummyjson' | 'mock')
NEXT_PUBLIC_DATA_PROVIDER="dummyjson"

# Cache Configuration (TTL in seconds)
NEXT_PUBLIC_CACHE_TTL_SECONDS=300

# Feature Flags (Future Phases)
# NEXT_PUBLIC_ENABLE_AI_ASSISTANT=false
# NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=false
